{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherLink",
  "version": "0.1.0",
  "identifier": "dev.aetherlink.mobile",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/sync-shared.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AetherLink",
        "url": "index.html",
        "backgroundColor": "#0B0E14"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost 'self'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Peer-to-peer remote desktop",
    "longDescription": "AetherLink is an open-source, end-to-end encrypted peer-to-peer remote desktop suite.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {}
}
