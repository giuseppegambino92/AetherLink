{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherLink",
  "version": "0.1.0",
  "identifier": "dev.aetherlink.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AetherLink",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        },
        "backgroundColor": "#0B0E1400",
        "windowEffects": {
          "effects": [
            "underWindowBackground",
            "mica"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost 'self'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Peer-to-peer remote desktop",
    "longDescription": "AetherLink is an open-source, end-to-end encrypted peer-to-peer remote desktop suite.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {}
}
